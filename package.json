{
  "name": "site-control",
  "private": true,
  "description": "Firebase tooling for Site Control (emulators, security-rule tests, deploys)",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-site-control",
    "test:rules": "firebase emulators:exec --project demo-site-control --only firestore \"node --test firebase/tests/rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.1"
  }
}
